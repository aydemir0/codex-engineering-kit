{
  "description": "Codex Engineering Kit native lifecycle hooks.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/scripts/hook_dispatch.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/hooks/scripts/hook_dispatch.py\"",
            "timeout": 5,
            "async": false
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/scripts/hook_dispatch.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/hooks/scripts/hook_dispatch.py\"",
            "timeout": 1,
            "async": false
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/scripts/hook_dispatch.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/hooks/scripts/hook_dispatch.py\"",
            "timeout": 5,
            "async": false
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/scripts/hook_dispatch.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/hooks/scripts/hook_dispatch.py\"",
            "timeout": 5,
            "async": false
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/scripts/hook_dispatch.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/hooks/scripts/hook_dispatch.py\"",
            "timeout": 5,
            "async": false
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/scripts/hook_dispatch.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/hooks/scripts/hook_dispatch.py\"",
            "timeout": 5,
            "async": false
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/scripts/hook_dispatch.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/hooks/scripts/hook_dispatch.py\"",
            "timeout": 5,
            "async": false
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/scripts/hook_dispatch.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/hooks/scripts/hook_dispatch.py\"",
            "timeout": 5,
            "async": false
          }
        ]
      }
    ]
  }
}
